# ===== Server-friendly config (.env) =====
# Demo: CRM/SRM service center system (offline-friendly)

APP_ENV=production
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_me
DATABASE_URL=sqlite:///./data/srm.db
UPLOADS_DIR=./uploads
ARTIFACTS_DIR=./outputs
LOG_DIR=./outputs/logs
DEBUG=false

# ===== Backward-compatible SRM_* variables (used by current code) =====
# If you prefer explicit SRM_* envs, keep them in sync with the variables above.
SRM_DB_PATH=./data/srm.db
SRM_ARTIFACTS_DIR=./outputs
SRM_UPLOADS_DIR=./uploads
SRM_RULES_PATH=./examples/repair_rules_ontology.json
SRM_SESSION_DAYS=7
SRM_HOST=127.0.0.1
SRM_PORT=8000
SRM_DEBUG=0

# Optional (useful for deterministic demo/tests):
# SRM_DEFAULT_ANALYSIS_DATE=2026-04-18
